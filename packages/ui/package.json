{
  "name": "@htmlos-next/ui",
  "version": "0.0.23",
  "license": "MIT",
  "author": "JCionx",
  "description": "Default component library for htmlOS NEXT.",
  "type": "module",
  "main": "./dist/htmlos-ui.cjs",
  "module": "./dist/htmlos-ui.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
